<div class="min-h-screen bg-gray-50">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <!-- Header -->
    <div class="mb-12">
      <h1 class="text-4xl font-bold text-gray-900 mb-3">Announcements</h1>
      <p class="text-lg text-gray-600">Stay up to date with the latest platform updates, new features, and improvements.</p>
    </div>

    <!-- Announcements List -->
    <% if @announcements.any? %>
      <div class="space-y-8">
        <% @announcements.each do |announcement| %>
          <article class="bg-white rounded-lg shadow-sm border border-gray-200 p-6 hover:shadow-md transition-shadow">
            <!-- Header with date and type badge -->
            <div class="flex items-center justify-between mb-3">
              <time datetime="<%= announcement.published_at&.iso8601 %>" class="text-sm text-gray-500">
                <%= announcement.published_at&.strftime("%B %d, %Y") %>
              </time>
              <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium <%= announcement.badge_color %>">
                <%= announcement.type_label %>
              </span>
            </div>

            <!-- Title -->
            <h2 class="text-2xl font-semibold text-gray-900 mb-3">
              <%= link_to announcement.title, announcement_path(announcement), class: "hover:text-indigo-600 transition-colors" %>
            </h2>

            <!-- Body preview -->
            <div class="prose prose-gray max-w-none">
              <%= simple_format(truncate(announcement.body, length: 300, separator: ' ')) %>
            </div>

            <!-- Read more link if truncated -->
            <% if announcement.body.length > 300 %>
              <div class="mt-4">
                <%= link_to "Read more →", announcement_path(announcement), class: "text-indigo-600 hover:text-indigo-700 font-medium text-sm" %>
              </div>
            <% end %>
          </article>
        <% end %>
      </div>

      <!-- Pagination -->
      <% if @announcements.total_pages > 1 %>
        <div class="mt-12 flex justify-center">
          <%= paginate @announcements, theme: 'tailwind' %>
        </div>
      <% end %>
    <% else %>
      <!-- Empty state -->
      <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-12 text-center">
        <%= icon 'megaphone', class: 'mx-auto h-12 w-12 text-gray-400 mb-4' %>
        <h3 class="text-lg font-medium text-gray-900 mb-2">No announcements yet</h3>
        <p class="text-gray-500">Check back soon for updates and new features!</p>
      </div>
    <% end %>
  </div>
</div>
