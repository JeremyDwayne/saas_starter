<div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <div class="mb-8">
    <%= link_to organizations_path, class: "text-sm font-medium text-indigo-600 hover:text-indigo-500" do %>
      ← Back to organizations
    <% end %>
  </div>

  <div class="bg-white shadow sm:rounded-lg">
    <div class="px-4 py-5 sm:p-6">
      <div class="flex items-center justify-between mb-6">
        <h1 class="text-2xl font-bold text-gray-900"><%= @organization.name %></h1>
        <div class="flex items-center space-x-3">
          <% membership = current_user.organization_memberships.find_by(organization: @organization) %>
          <% if membership&.admin? %>
            <%= link_to "Settings", edit_organization_path(@organization), class: "inline-flex items-center px-3 py-2 border border-gray-300 shadow-sm text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500" %>
          <% end %>
          <% if current_organization&.id != @organization.id %>
            <%= button_to "Switch to this organization", switch_organization_path(@organization), method: :post, class: "inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md shadow-sm text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500" %>
          <% else %>
            <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-indigo-100 text-indigo-800">
              Current Organization
            </span>
          <% end %>
        </div>
      </div>

      <dl class="grid grid-cols-1 gap-x-4 gap-y-6 sm:grid-cols-2">
        <div>
          <dt class="text-sm font-medium text-gray-500">Organization ID</dt>
          <dd class="mt-1 text-sm text-gray-900 font-mono"><%= @organization.id %></dd>
        </div>

        <div>
          <dt class="text-sm font-medium text-gray-500">Created</dt>
          <dd class="mt-1 text-sm text-gray-900"><%= @organization.created_at.strftime("%B %d, %Y") %></dd>
        </div>

        <div>
          <dt class="text-sm font-medium text-gray-500">Owner</dt>
          <dd class="mt-1 text-sm text-gray-900">
            <% if @organization.owner %>
              <%= @organization.owner.name || @organization.owner.email_address %>
              <% if @organization.owner_id == current_user.id %>
                <span class="ml-2 inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">
                  You
                </span>
              <% end %>
            <% else %>
              <span class="text-gray-400">No owner</span>
            <% end %>
          </dd>
        </div>

        <div>
          <dt class="text-sm font-medium text-gray-500">Members</dt>
          <dd class="mt-1 text-sm text-gray-900">
            <%= @organization.organization_memberships.count %> <%= "member".pluralize(@organization.organization_memberships.count) %>
          </dd>
        </div>

        <% if @organization.slug.present? %>
          <div>
            <dt class="text-sm font-medium text-gray-500">Slug</dt>
            <dd class="mt-1 text-sm text-gray-900 font-mono"><%= @organization.slug %></dd>
          </div>
        <% end %>
      </dl>
    </div>
  </div>

  <div class="mt-8 bg-gray-50 rounded-lg p-6">
    <h2 class="text-lg font-medium text-gray-900 mb-4">Quick Actions</h2>
    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
      <%= link_to dashboard_path, class: "inline-flex items-center justify-center px-4 py-2 border border-gray-300 shadow-sm text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500" do %>
        <%= icon 'chart-bar', class: 'mr-3 h-5 w-5 text-gray-400' %>
        View Dashboard
      <% end %>

      <%= link_to organization_members_path(@organization), class: "inline-flex items-center justify-center px-4 py-2 border border-gray-300 shadow-sm text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500" do %>
        <%= icon 'users', class: 'mr-3 h-5 w-5 text-gray-400' %>
        Manage Team
      <% end %>

      <%= link_to products_path, class: "inline-flex items-center justify-center px-4 py-2 border border-gray-300 shadow-sm text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500" do %>
        <%= icon 'cube', class: 'mr-3 h-5 w-5 text-gray-400' %>
        Manage Products
      <% end %>

      <%= link_to customers_path, class: "inline-flex items-center justify-center px-4 py-2 border border-gray-300 shadow-sm text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500" do %>
        <%= icon 'users', class: 'mr-3 h-5 w-5 text-gray-400' %>
        Manage Customers
      <% end %>

      <%= link_to invoices_path, class: "inline-flex items-center justify-center px-4 py-2 border border-gray-300 shadow-sm text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500" do %>
        <%= icon 'document-text', class: 'mr-3 h-5 w-5 text-gray-400' %>
        View Invoices
      <% end %>
    </div>
  </div>
</div>
