<div class="bg-gray-50 min-h-screen py-8">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Header -->
    <div class="mb-8">
      <div class="flex justify-between items-start">
        <div>
          <div class="flex items-center">
            <%= link_to customers_path, class: "text-gray-400 hover:text-gray-500 mr-4" do %>
              <%= icon 'arrow-left', class: 'h-5 w-5' %>
            <% end %>
            <h1 class="text-3xl font-bold text-gray-900"><%= @customer.name %></h1>
          </div>
          <p class="mt-1 text-sm text-gray-600">Customer details and invoice history</p>
        </div>
        <div class="flex space-x-3">
          <%= link_to "Edit", edit_customer_path(@customer), class: "inline-flex items-center px-4 py-2 border border-gray-300 rounded-md shadow-sm text-sm font-medium text-gray-700 bg-white hover:bg-gray-50" %>
          <%= link_to "Create Invoice", new_invoice_path(customer_id: @customer.id), class: "inline-flex items-center px-4 py-2 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-blue-600 hover:bg-blue-700" %>
        </div>
      </div>
    </div>

    <div class="grid grid-cols-1 gap-6 lg:grid-cols-3">
      <!-- Customer Information Card -->
      <div class="lg:col-span-1">
        <div class="bg-white shadow rounded-lg">
          <div class="px-4 py-5 sm:p-6">
            <h3 class="text-lg font-medium text-gray-900 mb-4">Contact Information</h3>

            <dl class="space-y-4">
              <div>
                <dt class="text-sm font-medium text-gray-500">Email</dt>
                <dd class="mt-1 text-sm text-gray-900">
                  <%= mail_to @customer.email, @customer.email, class: "text-blue-600 hover:text-blue-700" %>
                </dd>
              </div>

              <% if @customer.phone.present? %>
                <div>
                  <dt class="text-sm font-medium text-gray-500">Phone</dt>
                  <dd class="mt-1 text-sm text-gray-900"><%= @customer.phone %></dd>
                </div>
              <% end %>

              <% if @customer.address_line1.present? %>
                <div>
                  <dt class="text-sm font-medium text-gray-500">Billing Address</dt>
                  <dd class="mt-1 text-sm text-gray-900 whitespace-pre-line"><%= @customer.full_address %></dd>
                </div>
              <% end %>

              <% if @customer.notes.present? %>
                <div>
                  <dt class="text-sm font-medium text-gray-500">Internal Notes</dt>
                  <dd class="mt-1 text-sm text-gray-900"><%= simple_format(@customer.notes) %></dd>
                </div>
              <% end %>
            </dl>

            <% if @customer.stripe_customer_id.present? %>
              <div class="mt-6 pt-6 border-t border-gray-200">
                <p class="text-xs text-gray-500">
                  Stripe Customer ID: <code class="text-gray-700"><%= @customer.stripe_customer_id %></code>
                </p>
              </div>
            <% end %>
          </div>
        </div>

        <!-- Actions Card -->
        <div class="mt-6 bg-white shadow rounded-lg">
          <div class="px-4 py-5 sm:p-6">
            <h3 class="text-lg font-medium text-gray-900 mb-4">Actions</h3>

            <div class="space-y-3">
              <%= link_to edit_customer_path(@customer), class: "block w-full text-center px-4 py-2 border border-gray-300 rounded-md shadow-sm text-sm font-medium text-gray-700 bg-white hover:bg-gray-50" do %>
                Edit Customer
              <% end %>

              <% if @customer.invoices.empty? %>
                <%= button_to "Delete Customer", customer_path(@customer), method: :delete, class: "block w-full text-center px-4 py-2 border border-red-300 rounded-md shadow-sm text-sm font-medium text-red-700 bg-white hover:bg-red-50", form: { data: { turbo_confirm: "Are you sure? This cannot be undone." } } %>
              <% else %>
                <p class="text-xs text-gray-500 text-center">Cannot delete customer with invoices</p>
              <% end %>
            </div>
          </div>
        </div>
      </div>

      <!-- Invoice History Card -->
      <div class="lg:col-span-2">
        <div class="bg-white shadow rounded-lg">
          <div class="px-4 py-5 sm:p-6">
            <div class="flex justify-between items-center mb-4">
              <h3 class="text-lg font-medium text-gray-900">Invoice History</h3>
              <%= link_to "Create Invoice", new_invoice_path(customer_id: @customer.id), class: "text-sm font-medium text-blue-600 hover:text-blue-700" %>
            </div>

            <% if @invoices.any? %>
              <div class="overflow-hidden">
                <table class="min-w-full divide-y divide-gray-200">
                  <thead>
                    <tr>
                      <th scope="col" class="px-3 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Invoice</th>
                      <th scope="col" class="px-3 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Date</th>
                      <th scope="col" class="px-3 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Status</th>
                      <th scope="col" class="px-3 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Amount</th>
                      <th scope="col" class="relative px-3 py-3">
                        <span class="sr-only">View</span>
                      </th>
                    </tr>
                  </thead>
                  <tbody class="divide-y divide-gray-200">
                    <% @invoices.each do |invoice| %>
                      <tr class="hover:bg-gray-50">
                        <td class="px-3 py-4 whitespace-nowrap text-sm font-medium text-gray-900">
                          <%= invoice.invoice_number %>
                        </td>
                        <td class="px-3 py-4 whitespace-nowrap text-sm text-gray-500">
                          <%= invoice.created_at.strftime("%b %d, %Y") %>
                        </td>
                        <td class="px-3 py-4 whitespace-nowrap">
                          <% case invoice.status %>
                          <% when "draft" %>
                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-800">Draft</span>
                          <% when "open" %>
                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-yellow-100 text-yellow-800">Open</span>
                          <% when "paid" %>
                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">Paid</span>
                          <% when "void" %>
                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-red-100 text-red-800">Void</span>
                          <% when "uncollectible" %>
                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-red-100 text-red-800">Uncollectible</span>
                          <% end %>
                        </td>
                        <td class="px-3 py-4 whitespace-nowrap text-sm text-gray-900">
                          $<%= sprintf("%.2f", invoice.total_cents / 100.0) %>
                        </td>
                        <td class="px-3 py-4 whitespace-nowrap text-right text-sm font-medium">
                          <%= link_to "View", invoice_path(invoice), class: "text-blue-600 hover:text-blue-900" %>
                        </td>
                      </tr>
                    <% end %>
                  </tbody>
                </table>
              </div>

              <% if @customer.invoices.count > 10 %>
                <div class="mt-4 text-center">
                  <%= link_to "View all invoices", invoices_path(customer_id: @customer.id), class: "text-sm font-medium text-blue-600 hover:text-blue-700" %>
                </div>
              <% end %>
            <% else %>
              <div class="text-center py-12">
                <%= icon 'document-text', class: 'mx-auto h-12 w-12 text-gray-400' %>
                <h3 class="mt-2 text-sm font-medium text-gray-900">No invoices</h3>
                <p class="mt-1 text-sm text-gray-500">Get started by creating an invoice for this customer.</p>
                <div class="mt-6">
                  <%= link_to "Create Invoice", new_invoice_path(customer_id: @customer.id), class: "inline-flex items-center px-4 py-2 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-blue-600 hover:bg-blue-700" %>
                </div>
              </div>
            <% end %>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
