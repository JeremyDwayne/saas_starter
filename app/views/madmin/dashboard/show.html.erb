<div class="px-4 sm:px-6 lg:px-8 py-8">
  <div class="mb-8">
    <h1 class="text-3xl font-bold text-gray-900">Business Dashboard</h1>
    <p class="mt-2 text-sm text-gray-600">Key metrics and performance indicators</p>
  </div>

  <!-- Revenue Metrics -->
  <div class="mb-8">
    <h2 class="text-xl font-semibold text-gray-900 mb-4">Revenue Metrics</h2>
    <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-4">
      <!-- MRR -->
      <div class="bg-white overflow-hidden shadow rounded-lg">
        <div class="p-5">
          <div class="flex items-center">
            <div class="flex-shrink-0">
              <%= icon 'circle-dollar-sign', class: 'h-6 w-6 text-gray-400' %>
            </div>
            <div class="ml-5 w-0 flex-1">
              <dl>
                <dt class="text-sm font-medium text-gray-500 truncate">Monthly Recurring Revenue</dt>
                <dd class="flex items-baseline">
                  <div class="text-2xl font-semibold text-gray-900"><%= @metrics[:mrr][:formatted] %></div>
                </dd>
              </dl>
            </div>
          </div>
        </div>
      </div>

      <!-- ARR -->
      <div class="bg-white overflow-hidden shadow rounded-lg">
        <div class="p-5">
          <div class="flex items-center">
            <div class="flex-shrink-0">
              <%= icon 'trending-up', class: 'h-6 w-6 text-gray-400' %>
            </div>
            <div class="ml-5 w-0 flex-1">
              <dl>
                <dt class="text-sm font-medium text-gray-500 truncate">Annual Recurring Revenue</dt>
                <dd class="flex items-baseline">
                  <div class="text-2xl font-semibold text-gray-900">$<%= number_with_delimiter((@metrics[:arr] / 100.0).round(2)) %></div>
                </dd>
              </dl>
            </div>
          </div>
        </div>
      </div>

      <!-- Total Revenue -->
      <div class="bg-white overflow-hidden shadow rounded-lg">
        <div class="p-5">
          <div class="flex items-center">
            <div class="flex-shrink-0">
              <%= icon 'wallet', class: 'h-6 w-6 text-gray-400' %>
            </div>
            <div class="ml-5 w-0 flex-1">
              <dl>
                <dt class="text-sm font-medium text-gray-500 truncate">Total Revenue</dt>
                <dd class="flex items-baseline">
                  <div class="text-2xl font-semibold text-gray-900"><%= @metrics[:total_revenue][:formatted] %></div>
                </dd>
              </dl>
            </div>
          </div>
        </div>
      </div>

      <!-- Revenue This Month -->
      <div class="bg-white overflow-hidden shadow rounded-lg">
        <div class="p-5">
          <div class="flex items-center">
            <div class="flex-shrink-0">
              <%= icon 'bar-chart', class: 'h-6 w-6 text-gray-400' %>
            </div>
            <div class="ml-5 w-0 flex-1">
              <dl>
                <dt class="text-sm font-medium text-gray-500 truncate">Revenue This Month</dt>
                <dd class="flex items-baseline">
                  <div class="text-2xl font-semibold text-gray-900"><%= @metrics[:revenue_this_month][:formatted] %></div>
                  <% if @metrics[:revenue_growth_rate] > 0 %>
                    <p class="ml-2 flex items-baseline text-sm font-semibold text-green-600">
                      <%= icon 'arrow-up', class: 'h-5 w-5 flex-shrink-0 self-center text-green-500' %>
                      <%= @metrics[:revenue_growth_rate] %>%
                    </p>
                  <% elsif @metrics[:revenue_growth_rate] < 0 %>
                    <p class="ml-2 flex items-baseline text-sm font-semibold text-red-600">
                      <%= icon 'arrow-down', class: 'h-5 w-5 flex-shrink-0 self-center text-red-500' %>
                      <%= @metrics[:revenue_growth_rate].abs %>%
                    </p>
                  <% end %>
                </dd>
              </dl>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Subscription Metrics -->
  <div class="mb-8">
    <h2 class="text-xl font-semibold text-gray-900 mb-4">Subscription Metrics</h2>
    <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-4">
      <!-- Active Subscriptions -->
      <div class="bg-white overflow-hidden shadow rounded-lg">
        <div class="p-5">
          <div class="flex items-center">
            <div class="flex-shrink-0">
              <%= icon 'circle-check', class: 'h-6 w-6 text-gray-400' %>
            </div>
            <div class="ml-5 w-0 flex-1">
              <dl>
                <dt class="text-sm font-medium text-gray-500 truncate">Active Subscriptions</dt>
                <dd class="text-2xl font-semibold text-gray-900"><%= number_with_delimiter(@metrics[:active_subscriptions]) %></dd>
              </dl>
            </div>
          </div>
        </div>
      </div>

      <!-- Trial Subscriptions -->
      <div class="bg-white overflow-hidden shadow rounded-lg">
        <div class="p-5">
          <div class="flex items-center">
            <div class="flex-shrink-0">
              <%= icon 'clock', class: 'h-6 w-6 text-gray-400' %>
            </div>
            <div class="ml-5 w-0 flex-1">
              <dl>
                <dt class="text-sm font-medium text-gray-500 truncate">Trial Subscriptions</dt>
                <dd class="text-2xl font-semibold text-gray-900"><%= number_with_delimiter(@metrics[:trial_subscriptions]) %></dd>
              </dl>
            </div>
          </div>
        </div>
      </div>

      <!-- Total Customers -->
      <div class="bg-white overflow-hidden shadow rounded-lg">
        <div class="p-5">
          <div class="flex items-center">
            <div class="flex-shrink-0">
              <%= icon 'users', class: 'h-6 w-6 text-gray-400' %>
            </div>
            <div class="ml-5 w-0 flex-1">
              <dl>
                <dt class="text-sm font-medium text-gray-500 truncate">Total Customers</dt>
                <dd class="text-2xl font-semibold text-gray-900"><%= number_with_delimiter(@metrics[:total_customers]) %></dd>
              </dl>
            </div>
          </div>
        </div>
      </div>

      <!-- Churn Rate -->
      <div class="bg-white overflow-hidden shadow rounded-lg">
        <div class="p-5">
          <div class="flex items-center">
            <div class="flex-shrink-0">
              <%= icon 'trending-down', class: 'h-6 w-6 text-gray-400' %>
            </div>
            <div class="ml-5 w-0 flex-1">
              <dl>
                <dt class="text-sm font-medium text-gray-500 truncate">Monthly Churn Rate</dt>
                <dd class="text-2xl font-semibold text-gray-900"><%= @metrics[:churn_rate] %>%</dd>
              </dl>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Platform Metrics (Stripe Connect) -->
  <div class="mb-8">
    <h2 class="text-xl font-semibold text-gray-900 mb-4">Platform Revenue (Stripe Connect)</h2>
    <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
      <!-- Platform Revenue -->
      <div class="bg-white overflow-hidden shadow rounded-lg">
        <div class="p-5">
          <div class="flex items-center">
            <div class="flex-shrink-0">
              <%= icon 'circle-dollar-sign', class: 'h-6 w-6 text-gray-400' %>
            </div>
            <div class="ml-5 w-0 flex-1">
              <dl>
                <dt class="text-sm font-medium text-gray-500 truncate">Total Platform Fees</dt>
                <dd class="text-2xl font-semibold text-gray-900"><%= @metrics[:platform_revenue][:formatted] %></dd>
              </dl>
            </div>
          </div>
        </div>
      </div>

      <!-- Platform Revenue This Month -->
      <div class="bg-white overflow-hidden shadow rounded-lg">
        <div class="p-5">
          <div class="flex items-center">
            <div class="flex-shrink-0">
              <%= icon 'calendar', class: 'h-6 w-6 text-gray-400' %>
            </div>
            <div class="ml-5 w-0 flex-1">
              <dl>
                <dt class="text-sm font-medium text-gray-500 truncate">Platform Fees This Month</dt>
                <dd class="text-2xl font-semibold text-gray-900"><%= @metrics[:platform_revenue_this_month][:formatted] %></dd>
              </dl>
            </div>
          </div>
        </div>
      </div>

      <!-- Total Transactions -->
      <div class="bg-white overflow-hidden shadow rounded-lg">
        <div class="p-5">
          <div class="flex items-center">
            <div class="flex-shrink-0">
              <%= icon 'clipboard', class: 'h-6 w-6 text-gray-400' %>
            </div>
            <div class="ml-5 w-0 flex-1">
              <dl>
                <dt class="text-sm font-medium text-gray-500 truncate">Total Transactions</dt>
                <dd class="text-2xl font-semibold text-gray-900"><%= number_with_delimiter(@metrics[:total_transactions]) %></dd>
              </dl>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Customer Value Metrics -->
  <div class="mb-8">
    <h2 class="text-xl font-semibold text-gray-900 mb-4">Customer Value Metrics</h2>
    <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-4">
      <!-- LTV -->
      <div class="bg-white overflow-hidden shadow rounded-lg">
        <div class="p-5">
          <div class="flex items-center">
            <div class="flex-shrink-0">
              <%= icon 'star', class: 'h-6 w-6 text-gray-400' %>
            </div>
            <div class="ml-5 w-0 flex-1">
              <dl>
                <dt class="text-sm font-medium text-gray-500 truncate">Customer Lifetime Value</dt>
                <dd class="text-2xl font-semibold text-gray-900"><%= @metrics[:ltv][:formatted] %></dd>
              </dl>
            </div>
          </div>
        </div>
      </div>

      <!-- CAC -->
      <div class="bg-white overflow-hidden shadow rounded-lg">
        <div class="p-5">
          <div class="flex items-center">
            <div class="flex-shrink-0">
              <%= icon 'shopping-bag', class: 'h-6 w-6 text-gray-400' %>
            </div>
            <div class="ml-5 w-0 flex-1">
              <dl>
                <dt class="text-sm font-medium text-gray-500 truncate">Customer Acquisition Cost</dt>
                <dd class="text-2xl font-semibold text-gray-900"><%= @metrics[:cac][:formatted] %></dd>
              </dl>
            </div>
          </div>
        </div>
      </div>

      <!-- LTV:CAC Ratio -->
      <div class="bg-white overflow-hidden shadow rounded-lg">
        <div class="p-5">
          <div class="flex items-center">
            <div class="flex-shrink-0">
              <%= icon 'bar-chart', class: 'h-6 w-6 text-gray-400' %>
            </div>
            <div class="ml-5 w-0 flex-1">
              <dl>
                <dt class="text-sm font-medium text-gray-500 truncate">LTV:CAC Ratio</dt>
                <dd class="text-2xl font-semibold text-gray-900"><%= @metrics[:ltv_cac_ratio] %>:1</dd>
                <% if @metrics[:ltv_cac_ratio] >= 3 %>
                  <p class="text-sm text-green-600">Healthy ratio</p>
                <% elsif @metrics[:ltv_cac_ratio] >= 1 %>
                  <p class="text-sm text-yellow-600">Acceptable</p>
                <% else %>
                  <p class="text-sm text-red-600">Needs improvement</p>
                <% end %>
              </dl>
            </div>
          </div>
        </div>
      </div>

      <!-- ARPU -->
      <div class="bg-white overflow-hidden shadow rounded-lg">
        <div class="p-5">
          <div class="flex items-center">
            <div class="flex-shrink-0">
              <%= icon 'user', class: 'h-6 w-6 text-gray-400' %>
            </div>
            <div class="ml-5 w-0 flex-1">
              <dl>
                <dt class="text-sm font-medium text-gray-500 truncate">Avg Revenue Per User</dt>
                <dd class="text-2xl font-semibold text-gray-900"><%= @metrics[:average_revenue_per_user][:formatted] %></dd>
              </dl>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Referral Metrics -->
  <div class="mb-8">
    <h2 class="text-xl font-semibold text-gray-900 mb-4">Referral Program</h2>
    <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
      <!-- Total Credits -->
      <div class="bg-white overflow-hidden shadow rounded-lg">
        <div class="p-5">
          <div class="flex items-center">
            <div class="flex-shrink-0">
              <%= icon 'circle-dollar-sign', class: 'h-6 w-6 text-gray-400' %>
            </div>
            <div class="ml-5 w-0 flex-1">
              <dl>
                <dt class="text-sm font-medium text-gray-500 truncate">Total Referral Credits</dt>
                <dd class="text-2xl font-semibold text-gray-900"><%= @metrics[:total_referral_credits][:formatted] %></dd>
              </dl>
            </div>
          </div>
        </div>
      </div>

      <!-- Credits Used -->
      <div class="bg-white overflow-hidden shadow rounded-lg">
        <div class="p-5">
          <div class="flex items-center">
            <div class="flex-shrink-0">
              <%= icon 'circle-check', class: 'h-6 w-6 text-gray-400' %>
            </div>
            <div class="ml-5 w-0 flex-1">
              <dl>
                <dt class="text-sm font-medium text-gray-500 truncate">Credits Used</dt>
                <dd class="text-2xl font-semibold text-gray-900"><%= @metrics[:referral_credits_used][:formatted] %></dd>
              </dl>
            </div>
          </div>
        </div>
      </div>

      <!-- Successful Referrals -->
      <div class="bg-white overflow-hidden shadow rounded-lg">
        <div class="p-5">
          <div class="flex items-center">
            <div class="flex-shrink-0">
              <%= icon 'users', class: 'h-6 w-6 text-gray-400' %>
            </div>
            <div class="ml-5 w-0 flex-1">
              <dl>
                <dt class="text-sm font-medium text-gray-500 truncate">Successful Referrals</dt>
                <dd class="text-2xl font-semibold text-gray-900"><%= number_with_delimiter(@metrics[:successful_referrals]) %></dd>
              </dl>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
