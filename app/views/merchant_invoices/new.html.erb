<div class="bg-gray-50 min-h-screen py-8">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Header -->
    <div class="mb-8">
      <div class="flex items-center">
        <%= link_to invoices_path, class: "text-gray-400 hover:text-gray-500 mr-4" do %>
          <%= icon 'arrow-left', class: 'h-5 w-5' %>
        <% end %>
        <div>
          <h1 class="text-3xl font-bold text-gray-900">Create Invoice</h1>
          <p class="mt-1 text-sm text-gray-600">Create a new invoice for your customer</p>
        </div>
      </div>
    </div>

    <!-- Form Card -->
    <div class="bg-white shadow rounded-lg">
      <div class="px-4 py-5 sm:p-6">
        <%= render "form", invoice: @invoice %>
      </div>
    </div>
  </div>
</div>
