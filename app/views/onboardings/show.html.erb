<div class="bg-gray-50 min-h-screen py-8">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Header -->
    <div class="mb-8 text-center">
      <h1 class="text-3xl font-bold text-gray-900 mb-2">Welcome to Your Organization!</h1>
      <p class="text-gray-600">Let's get you set up in just a few quick steps</p>
    </div>

    <!-- Progress Bar -->
    <div class="mb-8">
      <div class="flex items-center justify-between mb-2">
        <span class="text-sm font-medium text-gray-700">Setup Progress</span>
        <span class="text-sm font-medium text-blue-600"><%= @onboarding.progress_percentage %>%</span>
      </div>
      <div class="w-full bg-gray-200 rounded-full h-2.5">
        <div class="bg-blue-600 h-2.5 rounded-full transition-all duration-500" style="width: <%= @onboarding.progress_percentage %>%"></div>
      </div>
    </div>

    <!-- Step Indicators -->
    <div class="mb-8">
      <div class="flex items-center justify-between">
        <% @steps.each_with_index do |step, index| %>
          <div class="flex flex-col items-center flex-1">
            <div class="flex items-center w-full">
              <% if index > 0 %>
                <div class="flex-1 h-1 <%= step[:completed] ? 'bg-green-500' : 'bg-gray-300' %> mx-2"></div>
              <% end %>

              <div class="relative flex flex-col items-center">
                <div class="w-12 h-12 rounded-full flex items-center justify-center <%= step[:completed] ? 'bg-green-500' : step[:current] ? 'bg-blue-600' : 'bg-gray-300' %> text-white font-semibold">
                  <% if step[:completed] %>
                    <%= icon 'check', class: 'h-6 w-6' %>
                  <% else %>
                    <%= index + 1 %>
                  <% end %>
                </div>
                <span class="mt-2 text-xs font-medium text-gray-700 text-center max-w-[100px]">
                  <%= step[:display_name].split.first %><br/><%= step[:display_name].split[1..].join(' ') %>
                </span>
              </div>

              <% if index < @steps.length - 1 %>
                <div class="flex-1 h-1 <%= step[:completed] ? 'bg-green-500' : 'bg-gray-300' %> mx-2"></div>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    </div>

    <!-- Step Content Card -->
    <div class="bg-white shadow rounded-lg p-8">
      <!-- Step Title -->
      <div class="mb-6">
        <h2 class="text-2xl font-bold text-gray-900 mb-2">
          <%= Onboarding::STEP_NAMES[@current_step_name] %>
        </h2>
        <p class="text-gray-600">
          <%= Onboarding::STEP_DESCRIPTIONS[@current_step_name] %>
        </p>
      </div>

      <!-- Step Forms -->
      <% case @current_step_name %>
      <% when :profile %>
        <%= form_with model: @user, url: onboarding_path(@onboarding), method: :patch, local: true, class: "space-y-6" do |form| %>
          <%= hidden_field_tag :step_name, :profile %>

          <div>
            <%= form.label :name, class: "block text-sm font-medium text-gray-700 mb-2" %>
            <%= form.text_field :name,
                class: "mt-1 block w-full border-gray-300 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500 sm:text-sm",
                placeholder: "Your full name" %>
            <% if @user&.errors&.[](:name)&.any? %>
              <p class="mt-1 text-sm text-red-600"><%= @user.errors[:name].first %></p>
            <% end %>
          </div>

          <div>
            <%= form.label :avatar_url, "Profile Picture URL (Optional)", class: "block text-sm font-medium text-gray-700 mb-2" %>
            <div class="flex items-center space-x-4">
              <% if @user.avatar_url.present? %>
                <img class="h-16 w-16 rounded-full object-cover" src="<%= @user.avatar_url %>" alt="Avatar preview">
              <% else %>
                <div class="h-16 w-16 rounded-full bg-gray-300 flex items-center justify-center">
                  <%= icon 'user', class: 'h-8 w-8 text-gray-400' %>
                </div>
              <% end %>
              <%= form.url_field :avatar_url,
                  class: "flex-1 block w-full border-gray-300 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500 sm:text-sm",
                  placeholder: "https://example.com/avatar.jpg" %>
            </div>
            <% if @user&.errors&.[](:avatar_url)&.any? %>
              <p class="mt-1 text-sm text-red-600"><%= @user.errors[:avatar_url].first %></p>
            <% end %>
          </div>

          <div class="flex justify-end space-x-3 pt-4">
            <%= form.submit "Continue", class: "bg-blue-600 hover:bg-blue-700 text-white px-6 py-2 rounded-md text-sm font-medium focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500" %>
          </div>
        <% end %>

      <% when :organization_details %>
        <%= form_with model: @organization, url: onboarding_path(@onboarding), method: :patch, local: true, class: "space-y-6" do |form| %>
          <%= hidden_field_tag :step_name, :organization_details %>

          <div>
            <%= form.label :name, "Organization Name", class: "block text-sm font-medium text-gray-700 mb-2" %>
            <%= form.text_field :name,
                class: "mt-1 block w-full border-gray-300 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500 sm:text-sm",
                placeholder: "Acme Inc." %>
            <% if @organization&.errors&.[](:name)&.any? %>
              <p class="mt-1 text-sm text-red-600"><%= @organization.errors[:name].first %></p>
            <% end %>
            <p class="mt-1 text-sm text-gray-500">The name of your organization or business</p>
          </div>

          <div>
            <%= form.label :slug, "Organization URL (Optional)", class: "block text-sm font-medium text-gray-700 mb-2" %>
            <div class="mt-1 flex rounded-md shadow-sm">
              <span class="inline-flex items-center px-3 rounded-l-md border border-r-0 border-gray-300 bg-gray-50 text-gray-500 text-sm">
                <%= request.base_url %>/
              </span>
              <%= form.text_field :slug,
                  class: "flex-1 block w-full border-gray-300 rounded-r-md shadow-sm focus:ring-blue-500 focus:border-blue-500 sm:text-sm",
                  placeholder: "acme-inc" %>
            </div>
            <% if @organization&.errors&.[](:slug)&.any? %>
              <p class="mt-1 text-sm text-red-600"><%= @organization.errors[:slug].first %></p>
            <% end %>
            <p class="mt-1 text-sm text-gray-500">A unique identifier for your organization (leave blank for auto-generation)</p>
          </div>

          <div class="flex justify-end space-x-3 pt-4">
            <%= form.submit "Continue", class: "bg-blue-600 hover:bg-blue-700 text-white px-6 py-2 rounded-md text-sm font-medium focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500" %>
          </div>
        <% end %>

      <% when :platform_configuration %>
        <div class="space-y-6">
          <div class="bg-blue-50 border border-blue-200 rounded-lg p-4">
            <div class="flex">
              <div class="flex-shrink-0">
                <%= icon 'info', class: 'h-5 w-5 text-blue-400' %>
              </div>
              <div class="ml-3">
                <h3 class="text-sm font-medium text-blue-800">Optional Configuration</h3>
                <div class="mt-2 text-sm text-blue-700">
                  <p>Platform configuration settings can be customized later from your organization settings. You can skip this step for now if you'd like to start using the platform right away.</p>
                </div>
              </div>
            </div>
          </div>

          <%= form_with url: onboarding_path(@onboarding), method: :patch, local: true, class: "space-y-6" do |form| %>
            <%= hidden_field_tag :step_name, :platform_configuration %>

            <!-- Add platform configuration fields here as needed -->
            <div class="bg-gray-50 rounded-lg p-4 text-center">
              <p class="text-sm text-gray-600">No additional configuration required at this time.</p>
            </div>

            <div class="flex justify-between pt-4">
              <%= button_to "Skip for Now", skip_step_onboarding_path(@onboarding, step_name: :platform_configuration),
                    method: :patch,
                    class: "bg-gray-300 hover:bg-gray-400 text-gray-700 px-6 py-2 rounded-md text-sm font-medium focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-gray-500" %>
              <%= form.submit "Continue", class: "bg-blue-600 hover:bg-blue-700 text-white px-6 py-2 rounded-md text-sm font-medium focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500" %>
            </div>
          <% end %>
        </div>

      <% when :stripe_connect %>
        <div class="space-y-6">
          <% if @stripe_connected %>
            <!-- Already Connected -->
            <div class="bg-green-50 border border-green-200 rounded-lg p-4">
              <div class="flex items-center">
                <%= icon 'check-circle', class: 'h-5 w-5 text-green-400 mr-2' %>
                <p class="text-sm font-medium text-green-800">Stripe Account Already Connected!</p>
              </div>
              <p class="text-sm text-green-700 mt-2">Your Stripe account is set up and ready to accept payments.</p>
            </div>

            <%= form_with url: onboarding_path(@onboarding), method: :patch, local: true, class: "mt-6" do |form| %>
              <%= hidden_field_tag :step_name, :stripe_connect %>
              <div class="flex justify-end">
                <%= form.submit "Complete Setup", class: "bg-blue-600 hover:bg-blue-700 text-white px-6 py-2 rounded-md text-sm font-medium focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500" %>
              </div>
            <% end %>
          <% else %>
            <!-- Not Connected Yet -->
            <div class="bg-blue-50 border border-blue-200 rounded-lg p-4">
              <div class="flex">
                <div class="flex-shrink-0">
                  <%= icon 'credit-card', class: 'h-5 w-5 text-blue-400' %>
                </div>
                <div class="ml-3">
                  <h3 class="text-sm font-medium text-blue-800">Connect Your Stripe Account</h3>
                  <div class="mt-2 text-sm text-blue-700">
                    <p>To accept payments from customers, you'll need to connect a Stripe account.</p>
                    <p class="mt-2"><strong>Platform Fee:</strong> <%= number_to_percentage(@fee_percentage, precision: 2) %> per transaction</p>
                  </div>
                </div>
              </div>
            </div>

            <div class="bg-white border border-gray-200 rounded-lg p-6">
              <h4 class="text-lg font-medium text-gray-900 mb-4">What you'll need:</h4>
              <ul class="space-y-2 text-sm text-gray-600">
                <li class="flex items-start">
                  <%= icon 'check', class: 'h-5 w-5 text-green-500 mr-2 flex-shrink-0' %>
                  <span>Business or personal banking information</span>
                </li>
                <li class="flex items-start">
                  <%= icon 'check', class: 'h-5 w-5 text-green-500 mr-2 flex-shrink-0' %>
                  <span>Tax identification number (EIN or SSN)</span>
                </li>
                <li class="flex items-start">
                  <%= icon 'check', class: 'h-5 w-5 text-green-500 mr-2 flex-shrink-0' %>
                  <span>Business address and contact information</span>
                </li>
              </ul>
            </div>

            <div class="flex justify-end space-x-3">
              <%= link_to "Connect Stripe Account", new_connected_account_path,
                    class: "bg-blue-600 hover:bg-blue-700 text-white px-6 py-2 rounded-md text-sm font-medium focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 inline-block" %>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>

    <!-- Help Section -->
    <div class="mt-8 text-center">
      <p class="text-sm text-gray-600">
        Need help?
        <a href="mailto:support@example.com" class="text-blue-600 hover:text-blue-700 font-medium">Contact Support</a>
      </p>
    </div>
  </div>
</div>
