<div class="bg-gray-50 min-h-screen py-8">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Header -->
    <div class="mb-8">
      <h1 class="text-3xl font-bold text-gray-900">Connect Your Stripe Account</h1>
      <p class="mt-1 text-sm text-gray-600">Start accepting payments from your customers through our platform</p>
    </div>

    <!-- Main Info Card -->
    <div class="bg-white shadow rounded-lg mb-6">
      <div class="px-4 py-5 sm:p-6">
        <div class="flex items-start mb-6">
          <div class="flex-shrink-0">
            <svg class="h-12 w-12 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"></path>
            </svg>
          </div>
          <div class="ml-4 flex-1">
            <h3 class="text-lg leading-6 font-medium text-gray-900 mb-2">Enable Direct Payments</h3>
            <p class="text-sm text-gray-600">
              Connect your Stripe account to accept payments directly from your customers. Customers will see your business name on their statements, and funds are deposited directly into your account.
            </p>
          </div>
        </div>

        <!-- Platform Fee Information -->
        <div class="bg-blue-50 border border-blue-200 rounded-lg p-4 mb-6">
          <div class="flex">
            <div class="flex-shrink-0">
              <%= icon 'information-circle', class: 'h-5 w-5 text-blue-400' %>
            </div>
            <div class="ml-3">
              <h4 class="text-sm font-medium text-blue-800">Platform Fee</h4>
              <div class="mt-2 text-sm text-blue-700">
                <p>Your current platform fee is <strong><%= number_to_percentage(@fee_percentage, precision: 2) %></strong> per transaction.</p>
                <p class="mt-1">This fee covers platform usage, payment processing infrastructure, and support.</p>
              </div>
            </div>
          </div>
        </div>

        <!-- Benefits List -->
        <div class="mb-6">
          <h4 class="text-sm font-medium text-gray-900 mb-3">What you get:</h4>
          <ul class="space-y-2">
            <li class="flex items-start">
              <div class="flex-shrink-0">
                <%= icon 'check-circle', class: 'h-5 w-5 text-green-500' %>
              </div>
              <p class="ml-3 text-sm text-gray-700">Direct deposits to your bank account</p>
            </li>
            <li class="flex items-start">
              <div class="flex-shrink-0">
                <%= icon 'check-circle', class: 'h-5 w-5 text-green-500' %>
              </div>
              <p class="ml-3 text-sm text-gray-700">Your business name on customer statements</p>
            </li>
            <li class="flex items-start">
              <div class="flex-shrink-0">
                <%= icon 'check-circle', class: 'h-5 w-5 text-green-500' %>
              </div>
              <p class="ml-3 text-sm text-gray-700">Detailed transaction history and reporting</p>
            </li>
            <li class="flex items-start">
              <div class="flex-shrink-0">
                <%= icon 'check-circle', class: 'h-5 w-5 text-green-500' %>
              </div>
              <p class="ml-3 text-sm text-gray-700">Access to Stripe Express Dashboard for payments management</p>
            </li>
            <li class="flex items-start">
              <div class="flex-shrink-0">
                <%= icon 'check-circle', class: 'h-5 w-5 text-green-500' %>
              </div>
              <p class="ml-3 text-sm text-gray-700">Automatic handling of refunds and disputes</p>
            </li>
          </ul>
        </div>

        <!-- How It Works -->
        <div class="bg-gray-50 rounded-lg p-4 mb-6">
          <h4 class="text-sm font-medium text-gray-900 mb-3">How it works:</h4>
          <ol class="space-y-2">
            <li class="flex items-start">
              <span class="flex-shrink-0 h-6 w-6 flex items-center justify-center rounded-full bg-blue-600 text-white text-xs font-medium">1</span>
              <p class="ml-3 text-sm text-gray-700">Click "Connect with Stripe" to start the secure onboarding process</p>
            </li>
            <li class="flex items-start">
              <span class="flex-shrink-0 h-6 w-6 flex items-center justify-center rounded-full bg-blue-600 text-white text-xs font-medium">2</span>
              <p class="ml-3 text-sm text-gray-700">Provide your business information and bank details to Stripe</p>
            </li>
            <li class="flex items-start">
              <span class="flex-shrink-0 h-6 w-6 flex items-center justify-center rounded-full bg-blue-600 text-white text-xs font-medium">3</span>
              <p class="ml-3 text-sm text-gray-700">Once approved, start charging customers immediately</p>
            </li>
            <li class="flex items-start">
              <span class="flex-shrink-0 h-6 w-6 flex items-center justify-center rounded-full bg-blue-600 text-white text-xs font-medium">4</span>
              <p class="ml-3 text-sm text-gray-700">Receive payouts directly to your bank account on Stripe's standard schedule</p>
            </li>
          </ol>
        </div>

        <!-- Action Button -->
        <div class="flex justify-center">
          <%= form_with url: connected_account_path, method: :post, local: true do |form| %>
            <%= form.submit "Connect with Stripe",
                  class: "inline-flex items-center px-6 py-3 border border-transparent text-base font-medium rounded-md text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 transition-colors" %>
          <% end %>
        </div>
      </div>
    </div>

    <!-- Security Notice -->
    <div class="bg-white shadow rounded-lg">
      <div class="px-4 py-5 sm:p-6">
        <div class="flex items-start">
          <div class="flex-shrink-0">
            <%= icon 'check-circle', class: 'h-5 w-5 text-green-500' %>
          </div>
          <div class="ml-3">
            <h4 class="text-sm font-medium text-gray-900">Secure Connection</h4>
            <p class="mt-1 text-sm text-gray-600">
              Your connection is handled by Stripe, a PCI-compliant payment processor trusted by millions of businesses worldwide. We never have access to your bank account information.
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
