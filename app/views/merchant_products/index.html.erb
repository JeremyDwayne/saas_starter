<div class="bg-gray-50 min-h-screen py-8">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Header -->
    <div class="mb-8">
      <div class="flex justify-between items-center">
        <div>
          <h1 class="text-3xl font-bold text-gray-900">Products & Services</h1>
          <p class="mt-1 text-sm text-gray-600">Manage your product catalog for invoicing</p>
        </div>
        <%= link_to "Add Product", new_product_path, class: "inline-flex items-center px-4 py-2 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500" %>
      </div>
    </div>

    <!-- Stats -->
    <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 mb-6">
      <div class="bg-white overflow-hidden shadow rounded-lg">
        <div class="px-4 py-5 sm:p-6">
          <dt class="text-sm font-medium text-gray-500 truncate">Active Products</dt>
          <dd class="mt-1 text-3xl font-semibold text-gray-900"><%= @active_products.count %></dd>
        </div>
      </div>
      <div class="bg-white overflow-hidden shadow rounded-lg">
        <div class="px-4 py-5 sm:p-6">
          <dt class="text-sm font-medium text-gray-500 truncate">Archived Products</dt>
          <dd class="mt-1 text-3xl font-semibold text-gray-900"><%= @inactive_products.count %></dd>
        </div>
      </div>
    </div>

    <!-- Search -->
    <%= form_with url: products_path, method: :get, class: "mb-6", data: { turbo_frame: "products_list" } do |f| %>
      <div class="flex gap-2">
        <%= f.text_field :query, value: params[:query], placeholder: "Search products...", class: "flex-1 block w-full border-gray-300 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500 sm:text-sm" %>
        <%= f.submit "Search", class: "inline-flex items-center px-4 py-2 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-blue-600 hover:bg-blue-700" %>
      </div>
    <% end %>

    <!-- Products List -->
    <div class="bg-white shadow overflow-hidden sm:rounded-md">
      <% if @products.any? %>
        <ul class="divide-y divide-gray-200">
          <% @products.each do |product| %>
            <li>
              <div class="px-4 py-4 sm:px-6 hover:bg-gray-50">
                <div class="flex items-center justify-between">
                  <div class="flex-1">
                    <div class="flex items-center">
                      <p class="text-sm font-medium text-blue-600 truncate">
                        <%= product.name %>
                      </p>
                      <% unless product.active? %>
                        <span class="ml-2 inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-800">
                          Archived
                        </span>
                      <% end %>
                    </div>
                    <div class="mt-2 sm:flex sm:justify-between">
                      <div class="sm:flex">
                        <p class="flex items-center text-sm text-gray-500">
                          <%= product.description&.truncate(100) || "No description" %>
                        </p>
                      </div>
                      <div class="mt-2 flex items-center text-sm text-gray-500 sm:mt-0">
                        <p class="font-medium text-gray-900">
                          <%= product.price_with_unit %>
                        </p>
                      </div>
                    </div>
                  </div>
                  <div class="ml-5 flex-shrink-0 flex items-center space-x-2">
                    <%= link_to "Edit", edit_product_path(product), class: "text-blue-600 hover:text-blue-900 text-sm font-medium" %>
                    <% if product.active? %>
                      <%= button_to "Archive", archive_product_path(product), method: :patch, class: "text-gray-600 hover:text-gray-900 text-sm font-medium", form: { data: { turbo_confirm: "Are you sure you want to archive this product?" } } %>
                    <% else %>
                      <%= button_to "Activate", unarchive_product_path(product), method: :patch, class: "text-green-600 hover:text-green-900 text-sm font-medium" %>
                    <% end %>
                    <% unless product.invoice_items.any? %>
                      <%= button_to "Delete", product_path(product), method: :delete, class: "text-red-600 hover:text-red-900 text-sm font-medium", form: { data: { turbo_confirm: "Are you sure you want to delete this product?" } } %>
                    <% end %>
                  </div>
                </div>
              </div>
            </li>
          <% end %>
        </ul>
      <% else %>
        <div class="text-center py-12">
          <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" />
          </svg>
          <h3 class="mt-2 text-sm font-medium text-gray-900">No products</h3>
          <p class="mt-1 text-sm text-gray-500">Get started by creating your first product or service.</p>
          <div class="mt-6">
            <%= link_to "Add Product", new_product_path, class: "inline-flex items-center px-4 py-2 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-blue-600 hover:bg-blue-700" %>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>
