<div class="min-h-screen bg-gray-50">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <!-- Back link -->
    <div class="mb-8">
      <%= link_to announcements_path, class: "inline-flex items-center text-sm font-medium text-indigo-600 hover:text-indigo-700" do %>
        <%= icon 'arrow-left', class: 'w-4 h-4 mr-2' %>
        Back to announcements
      <% end %>
    </div>

    <!-- Announcement content -->
    <article class="bg-white rounded-lg shadow-sm border border-gray-200 p-8">
      <!-- Header with date and type badge -->
      <div class="flex items-center justify-between mb-6">
        <time datetime="<%= @announcement.published_at&.iso8601 %>" class="text-sm text-gray-500">
          <%= @announcement.published_at&.strftime("%B %d, %Y") %>
        </time>
        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium <%= @announcement.badge_color %>">
          <%= @announcement.type_label %>
        </span>
      </div>

      <!-- Title -->
      <h1 class="text-3xl font-bold text-gray-900 mb-6">
        <%= @announcement.title %>
      </h1>

      <!-- Body -->
      <div class="prose prose-lg prose-gray max-w-none">
        <%= simple_format(@announcement.body) %>
      </div>
    </article>
  </div>
</div>
