<div class="bg-gray-50 min-h-screen py-8">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Header -->
    <div class="mb-8">
      <div class="flex justify-between items-start">
        <div class="flex items-center">
          <%= link_to invoices_path, class: "text-gray-400 hover:text-gray-500 mr-4" do %>
            <%= icon 'arrow-left', class: 'h-5 w-5' %>
          <% end %>
          <div>
            <h1 class="text-3xl font-bold text-gray-900"><%= @invoice.invoice_number %></h1>
            <p class="mt-1 text-sm text-gray-600">
              Invoice for <%= @invoice.customer.name %>
            </p>
          </div>
        </div>
        <div class="flex items-center space-x-3">
          <% case @invoice.status %>
          <% when "draft" %>
            <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-gray-100 text-gray-800">Draft</span>
          <% when "open" %>
            <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-yellow-100 text-yellow-800">Open</span>
          <% when "paid" %>
            <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-green-100 text-green-800">Paid</span>
          <% when "void" %>
            <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-red-100 text-red-800">Void</span>
          <% when "uncollectible" %>
            <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-red-100 text-red-800">Uncollectible</span>
          <% end %>
        </div>
      </div>
    </div>

    <!-- Invoice Preview Card -->
    <div class="bg-white shadow rounded-lg mb-6">
      <div class="px-8 py-10">
        <!-- Invoice Header -->
        <div class="flex justify-between mb-8">
          <div>
            <h2 class="text-2xl font-bold text-gray-900">INVOICE</h2>
            <p class="text-sm text-gray-600 mt-1"><%= @invoice.invoice_number %></p>
          </div>
          <div class="text-right">
            <p class="text-sm text-gray-600">Invoice Date</p>
            <p class="font-medium"><%= @invoice.created_at.strftime("%B %d, %Y") %></p>
            <% if @invoice.due_date %>
              <p class="text-sm text-gray-600 mt-2">Due Date</p>
              <p class="font-medium <%= @invoice.status == 'overdue' ? 'text-red-600' : '' %>">
                <%= @invoice.due_date.strftime("%B %d, %Y") %>
              </p>
            <% end %>
          </div>
        </div>

        <!-- From/To -->
        <div class="grid grid-cols-2 gap-8 mb-8 pb-8 border-b border-gray-200">
          <div>
            <p class="text-sm font-medium text-gray-500 mb-2">From</p>
            <p class="font-medium"><%= Current.user.name || Current.user.email %></p>
            <% if Current.user.merchant&.business_name.present? %>
              <p class="text-sm text-gray-600"><%= Current.user.merchant.business_name %></p>
            <% end %>
          </div>
          <div>
            <p class="text-sm font-medium text-gray-500 mb-2">Bill To</p>
            <p class="font-medium"><%= @invoice.customer.name %></p>
            <p class="text-sm text-gray-600"><%= @invoice.customer.email %></p>
            <% if @invoice.customer.address_line1.present? %>
              <p class="text-sm text-gray-600 mt-2 whitespace-pre-line"><%= @invoice.customer.full_address %></p>
            <% end %>
          </div>
        </div>

        <!-- Line Items -->
        <div class="mb-8">
          <table class="min-w-full divide-y divide-gray-200">
            <thead>
              <tr>
                <th scope="col" class="px-0 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Description</th>
                <th scope="col" class="px-3 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">Qty</th>
                <th scope="col" class="px-3 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">Unit Price</th>
                <th scope="col" class="px-3 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">Amount</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-200">
              <% @invoice.invoice_items.each do |item| %>
                <tr>
                  <td class="px-0 py-4 text-sm text-gray-900"><%= item.description %></td>
                  <td class="px-3 py-4 text-sm text-gray-900 text-right"><%= item.quantity %></td>
                  <td class="px-3 py-4 text-sm text-gray-900 text-right">$<%= sprintf("%.2f", item.unit_price_cents / 100.0) %></td>
                  <td class="px-3 py-4 text-sm text-gray-900 text-right font-medium">$<%= sprintf("%.2f", item.amount_cents / 100.0) %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>

        <!-- Totals -->
        <div class="flex justify-end mb-8">
          <div class="w-64 space-y-2">
            <div class="flex justify-between text-sm">
              <span class="text-gray-600">Subtotal:</span>
              <span class="text-gray-900">$<%= sprintf("%.2f", @invoice.subtotal_cents / 100.0) %></span>
            </div>
            <div class="flex justify-between text-sm">
              <span class="text-gray-600">Tax:</span>
              <span class="text-gray-900">$<%= sprintf("%.2f", @invoice.tax_cents / 100.0) %></span>
            </div>
            <div class="flex justify-between text-base font-semibold border-t border-gray-200 pt-2">
              <span class="text-gray-900">Total:</span>
              <span class="text-gray-900">$<%= sprintf("%.2f", @invoice.total_cents / 100.0) %></span>
            </div>
            <% if @invoice.application_fee_cents > 0 %>
              <div class="flex justify-between text-xs text-gray-500 pt-2">
                <span>Platform Fee:</span>
                <span>$<%= sprintf("%.2f", @invoice.application_fee_cents / 100.0) %></span>
              </div>
            <% end %>
          </div>
        </div>

        <!-- Notes -->
        <% if @invoice.notes.present? %>
          <div class="mb-4">
            <p class="text-sm font-medium text-gray-700 mb-1">Notes</p>
            <p class="text-sm text-gray-600"><%= simple_format(@invoice.notes) %></p>
          </div>
        <% end %>

        <!-- Footer -->
        <% if @invoice.footer_text.present? %>
          <div class="border-t border-gray-200 pt-4">
            <p class="text-sm text-gray-600 text-center"><%= @invoice.footer_text %></p>
          </div>
        <% end %>
      </div>
    </div>

    <!-- Actions Card -->
    <div class="bg-white shadow rounded-lg">
      <div class="px-4 py-5 sm:p-6">
        <h3 class="text-lg font-medium text-gray-900 mb-4">Actions</h3>

        <div class="space-y-3">
          <% if @invoice.draft? %>
            <div class="flex space-x-3">
              <%= link_to edit_invoice_path(@invoice), class: "flex-1 inline-flex justify-center items-center px-4 py-2 border border-gray-300 rounded-md shadow-sm text-sm font-medium text-gray-700 bg-white hover:bg-gray-50" do %>
                <%= icon 'edit', class: '-ml-1 mr-2 h-5 w-5 text-gray-500' %>
                Edit Invoice
              <% end %>

              <%= button_to send_invoice_invoice_path(@invoice), method: :post, class: "flex-1 inline-flex justify-center items-center px-4 py-2 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-blue-600 hover:bg-blue-700", form: { data: { turbo_confirm: "Send this invoice to #{@invoice.customer.name}?" } } do %>
                <%= icon 'mail', class: '-ml-1 mr-2 h-5 w-5' %>
                Send Invoice
              <% end %>
            </div>

            <%= button_to "Delete Draft", invoice_path(@invoice), method: :delete, class: "w-full inline-flex justify-center items-center px-4 py-2 border border-red-300 rounded-md shadow-sm text-sm font-medium text-red-700 bg-white hover:bg-red-50", form: { data: { turbo_confirm: "Are you sure? This cannot be undone." } } %>

          <% elsif @invoice.open? %>
            <div class="flex space-x-3">
              <%= button_to mark_paid_invoice_path(@invoice), method: :post, class: "flex-1 inline-flex justify-center items-center px-4 py-2 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-green-600 hover:bg-green-700" do %>
                <%= icon 'check-circle', class: '-ml-1 mr-2 h-5 w-5' %>
                Mark as Paid
              <% end %>

              <%= button_to void_invoice_path(@invoice), method: :post, class: "flex-1 inline-flex justify-center items-center px-4 py-2 border border-gray-300 rounded-md shadow-sm text-sm font-medium text-gray-700 bg-white hover:bg-gray-50", form: { data: { turbo_confirm: "Void this invoice?" } } do %>
                <%= icon 'x', class: '-ml-1 mr-2 h-5 w-5 text-gray-500' %>
                Void Invoice
              <% end %>
            </div>

          <% elsif @invoice.paid? %>
            <div class="rounded-md bg-green-50 p-4">
              <div class="flex">
                <div class="flex-shrink-0">
                  <%= icon 'check-circle', class: 'h-5 w-5 text-green-400' %>
                </div>
                <div class="ml-3">
                  <h3 class="text-sm font-medium text-green-800">Invoice Paid</h3>
                  <div class="mt-2 text-sm text-green-700">
                    <p>This invoice has been paid in full.</p>
                  </div>
                </div>
              </div>
            </div>
          <% end %>

          <% if @invoice.stripe_invoice_id.present? %>
            <div class="border-t border-gray-200 pt-4">
              <p class="text-xs text-gray-500">
                Stripe Invoice ID: <code class="text-gray-700"><%= @invoice.stripe_invoice_id %></code>
              </p>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
