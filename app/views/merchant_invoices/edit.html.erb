<div class="bg-gray-50 min-h-screen py-8">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Header -->
    <div class="mb-8">
      <div class="flex items-center">
        <%= link_to invoice_path(@invoice), class: "text-gray-400 hover:text-gray-500 mr-4" do %>
          <%= icon 'arrow-left', class: 'h-5 w-5' %>
        <% end %>
        <div>
          <h1 class="text-3xl font-bold text-gray-900">Edit Invoice</h1>
          <p class="mt-1 text-sm text-gray-600">Update invoice <%= @invoice.invoice_number %></p>
        </div>
      </div>
    </div>

    <% unless @invoice.draft? %>
      <div class="rounded-md bg-yellow-50 p-4 mb-6">
        <div class="flex">
          <div class="flex-shrink-0">
            <%= icon 'warning-triangle', class: 'h-5 w-5 text-yellow-400' %>
          </div>
          <div class="ml-3">
            <h3 class="text-sm font-medium text-yellow-800">
              This invoice has been sent and cannot be edited
            </h3>
            <div class="mt-2 text-sm text-yellow-700">
              <p>Only draft invoices can be edited. To make changes, you'll need to void this invoice and create a new one.</p>
            </div>
          </div>
        </div>
      </div>
    <% end %>

    <!-- Form Card -->
    <div class="bg-white shadow rounded-lg">
      <div class="px-4 py-5 sm:p-6">
        <%= render "form", invoice: @invoice %>
      </div>
    </div>
  </div>
</div>
