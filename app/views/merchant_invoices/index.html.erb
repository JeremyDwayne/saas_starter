<div class="bg-gray-50 min-h-screen py-8">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Header -->
    <div class="mb-8">
      <div class="flex justify-between items-center">
        <div>
          <h1 class="text-3xl font-bold text-gray-900">Invoices</h1>
          <p class="mt-1 text-sm text-gray-600">Create and manage invoices for your customers</p>
        </div>
        <%= link_to "Create Invoice", new_invoice_path, class: "inline-flex items-center px-4 py-2 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500" %>
      </div>
    </div>

    <!-- Stats -->
    <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-4 mb-6">
      <div class="bg-white overflow-hidden shadow rounded-lg">
        <div class="px-4 py-5 sm:p-6">
          <dt class="text-sm font-medium text-gray-500 truncate">Draft</dt>
          <dd class="mt-1 text-3xl font-semibold text-gray-900"><%= @draft_count %></dd>
        </div>
      </div>
      <div class="bg-white overflow-hidden shadow rounded-lg">
        <div class="px-4 py-5 sm:p-6">
          <dt class="text-sm font-medium text-gray-500 truncate">Open</dt>
          <dd class="mt-1 text-3xl font-semibold text-yellow-600"><%= @open_count %></dd>
        </div>
      </div>
      <div class="bg-white overflow-hidden shadow rounded-lg">
        <div class="px-4 py-5 sm:p-6">
          <dt class="text-sm font-medium text-gray-500 truncate">Paid</dt>
          <dd class="mt-1 text-3xl font-semibold text-green-600"><%= @paid_count %></dd>
        </div>
      </div>
      <div class="bg-white overflow-hidden shadow rounded-lg">
        <div class="px-4 py-5 sm:p-6">
          <dt class="text-sm font-medium text-gray-500 truncate">Outstanding</dt>
          <dd class="mt-1 text-2xl font-semibold text-gray-900">$<%= sprintf("%.2f", @total_outstanding / 100.0) %></dd>
        </div>
      </div>
    </div>

    <!-- Filter Tabs -->
    <div class="bg-white shadow sm:rounded-lg mb-6">
      <div class="border-b border-gray-200">
        <nav class="-mb-px flex space-x-8 px-6" aria-label="Tabs">
          <%= link_to invoices_path, class: "#{params[:status].blank? ? 'border-blue-500 text-blue-600' : 'border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300'} whitespace-nowrap py-4 px-1 border-b-2 font-medium text-sm" do %>
            All Invoices
          <% end %>
          <%= link_to invoices_path(status: "draft"), class: "#{params[:status] == 'draft' ? 'border-blue-500 text-blue-600' : 'border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300'} whitespace-nowrap py-4 px-1 border-b-2 font-medium text-sm" do %>
            Draft
          <% end %>
          <%= link_to invoices_path(status: "open"), class: "#{params[:status] == 'open' ? 'border-blue-500 text-blue-600' : 'border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300'} whitespace-nowrap py-4 px-1 border-b-2 font-medium text-sm" do %>
            Open
          <% end %>
          <%= link_to invoices_path(status: "paid"), class: "#{params[:status] == 'paid' ? 'border-blue-500 text-blue-600' : 'border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300'} whitespace-nowrap py-4 px-1 border-b-2 font-medium text-sm" do %>
            Paid
          <% end %>
        </nav>
      </div>
    </div>

    <!-- Invoices List -->
    <div class="bg-white shadow overflow-hidden sm:rounded-md">
      <% if @invoices.any? %>
        <ul class="divide-y divide-gray-200">
          <% @invoices.each do |invoice| %>
            <li>
              <%= link_to invoice_path(invoice), class: "block hover:bg-gray-50" do %>
                <div class="px-4 py-4 sm:px-6">
                  <div class="flex items-center justify-between">
                    <div class="flex-1 min-w-0">
                      <div class="flex items-center justify-between">
                        <p class="text-sm font-medium text-blue-600 truncate">
                          <%= invoice.invoice_number %>
                        </p>
                        <div class="ml-2 flex-shrink-0 flex">
                          <% case invoice.status %>
                          <% when "draft" %>
                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-800">Draft</span>
                          <% when "open" %>
                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-yellow-100 text-yellow-800">Open</span>
                          <% when "paid" %>
                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">Paid</span>
                          <% when "void" %>
                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-red-100 text-red-800">Void</span>
                          <% when "uncollectible" %>
                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-red-100 text-red-800">Uncollectible</span>
                          <% end %>
                        </div>
                      </div>
                      <div class="mt-2 sm:flex sm:justify-between">
                        <div class="sm:flex">
                          <p class="flex items-center text-sm text-gray-500">
                            <%= icon 'user', class: 'flex-shrink-0 mr-1.5 h-5 w-5 text-gray-400' %>
                            <%= invoice.customer.name %>
                          </p>
                          <p class="mt-2 flex items-center text-sm text-gray-500 sm:mt-0 sm:ml-6">
                            <%= icon 'calendar', class: 'flex-shrink-0 mr-1.5 h-5 w-5 text-gray-400' %>
                            <%= invoice.created_at.strftime("%b %d, %Y") %>
                          </p>
                        </div>
                        <div class="mt-2 flex items-center text-sm text-gray-900 sm:mt-0 font-medium">
                          $<%= sprintf("%.2f", invoice.total_cents / 100.0) %>
                        </div>
                      </div>
                    </div>
                    <div class="ml-5 flex-shrink-0">
                      <%= icon 'chevron-right', class: 'h-5 w-5 text-gray-400' %>
                    </div>
                  </div>
                </div>
              <% end %>
            </li>
          <% end %>
        </ul>
      <% else %>
        <div class="text-center py-12">
          <%= icon 'document-text', class: 'mx-auto h-12 w-12 text-gray-400' %>
          <h3 class="mt-2 text-sm font-medium text-gray-900">No invoices</h3>
          <p class="mt-1 text-sm text-gray-500">Get started by creating your first invoice.</p>
          <div class="mt-6">
            <%= link_to "Create Invoice", new_invoice_path, class: "inline-flex items-center px-4 py-2 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-blue-600 hover:bg-blue-700" %>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>
