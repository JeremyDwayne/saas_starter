<div class="bg-gray-50 min-h-screen py-8">
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Header -->
    <div class="mb-8">
      <h1 class="text-3xl font-bold text-gray-900">Create New Charge</h1>
      <p class="mt-1 text-sm text-gray-600">Charge a customer and receive payment directly to your account</p>
    </div>

    <!-- Charge Form -->
    <div class="bg-white shadow rounded-lg mb-6">
      <div class="px-4 py-5 sm:p-6">
        <%= form_with model: :charge, url: charges_path, method: :post, local: true, class: "space-y-6", data: { controller: "fee-calculator" } do |form| %>

          <!-- Amount Field -->
          <div>
            <%= form.label :amount_cents, "Charge Amount", class: "block text-sm font-medium text-gray-700 mb-1" %>
            <div class="mt-1 relative rounded-md shadow-sm">
              <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                <span class="text-gray-500 sm:text-sm">$</span>
              </div>
              <%= form.number_field :amount_cents,
                    required: true,
                    min: 50,
                    step: 1,
                    placeholder: "0.00",
                    data: {
                      fee_calculator_target: "amount",
                      action: "input->fee-calculator#calculate"
                    },
                    class: "pl-7 block w-full border-gray-300 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500 sm:text-sm" %>
            </div>
            <p class="mt-1 text-sm text-gray-500">Enter amount in cents (e.g., 1000 = $10.00). Minimum $0.50</p>
          </div>

          <!-- Customer Email Field -->
          <div>
            <%= form.label :customer_email, "Customer Email", class: "block text-sm font-medium text-gray-700 mb-1" %>
            <%= form.email_field :customer_email,
                  required: true,
                  placeholder: "customer@example.com",
                  class: "mt-1 block w-full border-gray-300 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500 sm:text-sm" %>
            <p class="mt-1 text-sm text-gray-500">Receipt will be sent to this email address</p>
          </div>

          <!-- Description Field -->
          <div>
            <%= form.label :description, "Description", class: "block text-sm font-medium text-gray-700 mb-1" %>
            <%= form.text_area :description,
                  rows: 3,
                  placeholder: "What is this charge for?",
                  class: "mt-1 block w-full border-gray-300 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500 sm:text-sm" %>
            <p class="mt-1 text-sm text-gray-500">This will appear on the customer's statement</p>
          </div>

          <!-- Fee Preview Card -->
          <div class="bg-blue-50 border border-blue-200 rounded-lg p-4">
            <h4 class="text-sm font-medium text-blue-900 mb-3">Fee Breakdown</h4>

            <dl class="space-y-2">
              <div class="flex justify-between text-sm">
                <dt class="text-blue-700">Charge Amount:</dt>
                <dd class="font-medium text-blue-900" data-fee-calculator-target="chargeDisplay">
                  $<%= sprintf("%.2f", @fee_calculation[:amount_cents] / 100.0) %>
                </dd>
              </div>

              <div class="flex justify-between text-sm">
                <dt class="text-blue-700">
                  Platform Fee (<%= number_to_percentage(@fee_calculation[:fee_percentage], precision: 2) %>):
                </dt>
                <dd class="font-medium text-blue-900" data-fee-calculator-target="feeDisplay">
                  $<%= sprintf("%.2f", @fee_calculation[:fee_cents] / 100.0) %>
                </dd>
              </div>

              <div class="border-t border-blue-300 pt-2 mt-2"></div>

              <div class="flex justify-between text-sm font-semibold">
                <dt class="text-blue-800">You Receive:</dt>
                <dd class="text-green-600" data-fee-calculator-target="netDisplay">
                  $<%= sprintf("%.2f", @fee_calculation[:net_amount_cents] / 100.0) %>
                </dd>
              </div>
            </dl>

            <p class="mt-3 text-xs text-blue-600">
              Fee source:
              <% case @fee_calculation[:fee_source] %>
              <% when "custom" %>
                <span class="font-medium">Custom rate (negotiated)</span>
              <% when "tier" %>
                <span class="font-medium">Subscription tier rate</span>
              <% else %>
                <span class="font-medium">Default rate</span>
              <% end %>
            </p>
          </div>

          <!-- Hidden field for fee percentage -->
          <%= form.hidden_field :fee_percentage, value: @fee_calculation[:fee_percentage], data: { fee_calculator_target: "feePercentage" } %>

          <!-- Submit Button -->
          <div class="flex justify-end space-x-3">
            <%= link_to "Cancel", charges_path, class: "inline-flex items-center px-4 py-2 border border-gray-300 rounded-md shadow-sm text-sm font-medium text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500" %>

            <%= form.submit "Create Charge",
                  class: "inline-flex items-center px-4 py-2 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500" %>
          </div>
        <% end %>
      </div>
    </div>

    <!-- Info Notice -->
    <div class="bg-white shadow rounded-lg">
      <div class="px-4 py-5 sm:p-6">
        <div class="flex items-start">
          <div class="flex-shrink-0">
            <%= icon 'information-circle', class: 'h-5 w-5 text-gray-400' %>
          </div>
          <div class="ml-3">
            <h4 class="text-sm font-medium text-gray-900">Payment Processing</h4>
            <p class="mt-1 text-sm text-gray-600">
              The charge will be created on your connected Stripe account. Customers will see your business name on their statement, and funds will be deposited directly into your account after Stripe's standard processing time.
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
