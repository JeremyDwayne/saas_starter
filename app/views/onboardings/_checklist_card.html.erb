<% if @onboarding && !@onboarding.complete? %>
  <div class="bg-gradient-to-r from-blue-50 to-indigo-50 border-2 border-blue-200 rounded-lg shadow-md mb-6">
    <div class="p-6">
      <!-- Header -->
      <div class="flex items-start justify-between mb-4">
        <div class="flex items-center">
          <%= icon 'clipboard-list', class: 'h-6 w-6 text-blue-600 mr-3' %>
          <div>
            <h3 class="text-lg font-semibold text-gray-900">Complete Your Setup</h3>
            <p class="text-sm text-gray-600 mt-1">Finish setting up your organization to unlock all features</p>
          </div>
        </div>
        <div class="flex flex-col items-end">
          <span class="text-2xl font-bold text-blue-600"><%= @onboarding.progress_percentage %>%</span>
          <span class="text-xs text-gray-500">Complete</span>
        </div>
      </div>

      <!-- Progress Bar -->
      <div class="mb-6">
        <div class="w-full bg-gray-200 rounded-full h-2.5">
          <div class="bg-blue-600 h-2.5 rounded-full transition-all duration-500" style="width: <%= @onboarding.progress_percentage %>%"></div>
        </div>
      </div>

      <!-- Checklist Items -->
      <div class="space-y-3 mb-6">
        <% @onboarding.steps_with_status.each do |step| %>
          <div class="flex items-center justify-between p-3 bg-white rounded-lg border <%= step[:completed] ? 'border-green-200' : 'border-gray-200' %> hover:shadow-sm transition-shadow">
            <div class="flex items-center flex-1">
              <div class="flex-shrink-0 mr-3">
                <% if step[:completed] %>
                  <div class="w-6 h-6 rounded-full bg-green-500 flex items-center justify-center">
                    <%= icon 'check', class: 'h-4 w-4 text-white' %>
                  </div>
                <% else %>
                  <div class="w-6 h-6 rounded-full border-2 <%= step[:current] ? 'border-blue-500' : 'border-gray-300' %> flex items-center justify-center">
                    <% if step[:current] %>
                      <div class="w-3 h-3 rounded-full bg-blue-500"></div>
                    <% end %>
                  </div>
                <% end %>
              </div>
              <div class="flex-1">
                <h4 class="text-sm font-medium <%= step[:completed] ? 'text-gray-500 line-through' : 'text-gray-900' %>">
                  <%= step[:display_name] %>
                </h4>
                <p class="text-xs text-gray-500"><%= step[:description] %></p>
              </div>
            </div>
            <% unless step[:completed] %>
              <% if step[:current] %>
                <%= link_to onboarding_path(@onboarding), class: "ml-4 text-blue-600 hover:text-blue-700 text-sm font-medium flex items-center" do %>
                  Continue
                  <%= icon 'arrow-right', class: 'h-4 w-4 ml-1' %>
                <% end %>
              <% end %>
            <% end %>
          </div>
        <% end %>
      </div>

      <!-- CTA Button -->
      <div class="flex items-center justify-between pt-4 border-t border-blue-200">
        <p class="text-sm text-gray-600">
          <span class="font-medium"><%= 4 - @onboarding.steps_with_status.count { |s| s[:completed] } %></span> steps remaining
        </p>
        <%= link_to onboarding_path(@onboarding), class: "bg-blue-600 hover:bg-blue-700 text-white px-6 py-2 rounded-md text-sm font-medium focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 inline-flex items-center" do %>
          <%= icon 'play', class: 'h-4 w-4 mr-2' %>
          Continue Setup
        <% end %>
      </div>
    </div>
  </div>
<% end %>
