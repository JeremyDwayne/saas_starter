<div class="bg-gray-50 min-h-screen py-8">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Header -->
    <div class="mb-8">
      <div class="flex items-center space-x-4 mb-4">
        <%= link_to charges_path, class: "text-gray-400 hover:text-gray-600" do %>
          <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
          </svg>
        <% end %>
        <h1 class="text-3xl font-bold text-gray-900">Transaction Details</h1>
      </div>
      <p class="text-sm text-gray-600">Stripe Charge ID: <%= @transaction.stripe_charge_id %></p>
    </div>

    <!-- Status Banner -->
    <% case @transaction.status %>
    <% when "succeeded" %>
      <div class="mb-6 bg-green-50 border border-green-200 rounded-lg p-4">
        <div class="flex items-center">
          <%= icon 'check-circle', class: 'h-5 w-5 text-green-500' %>
          <p class="ml-3 text-sm font-medium text-green-800">
            Payment succeeded on <%= @transaction.created_at.strftime("%B %d, %Y at %I:%M %p") %>
          </p>
        </div>
      </div>
    <% when "refunded" %>
      <div class="mb-6 bg-red-50 border border-red-200 rounded-lg p-4">
        <div class="flex items-center">
          <%= icon 'x', class: 'h-5 w-5 text-red-500' %>
          <p class="ml-3 text-sm font-medium text-red-800">
            This charge has been fully refunded
          </p>
        </div>
      </div>
    <% when "partially_refunded" %>
      <div class="mb-6 bg-yellow-50 border border-yellow-200 rounded-lg p-4">
        <div class="flex items-center">
          <%= icon 'exclamation-triangle', class: 'h-5 w-5 text-yellow-500' %>
          <p class="ml-3 text-sm font-medium text-yellow-800">
            This charge has been partially refunded
          </p>
        </div>
      </div>
    <% end %>

    <!-- Payment Details -->
    <div class="bg-white shadow rounded-lg mb-6">
      <div class="px-4 py-5 sm:p-6">
        <h3 class="text-lg leading-6 font-medium text-gray-900 mb-6">Payment Details</h3>

        <dl class="grid grid-cols-1 gap-x-4 gap-y-6 sm:grid-cols-2">
          <!-- Customer Email -->
          <div class="sm:col-span-1">
            <dt class="text-sm font-medium text-gray-500">Customer Email</dt>
            <dd class="mt-1 text-sm text-gray-900"><%= @transaction.customer_email %></dd>
          </div>

          <!-- Date -->
          <div class="sm:col-span-1">
            <dt class="text-sm font-medium text-gray-500">Transaction Date</dt>
            <dd class="mt-1 text-sm text-gray-900"><%= @transaction.created_at.strftime("%B %d, %Y at %I:%M %p") %></dd>
          </div>

          <!-- Description -->
          <div class="sm:col-span-2">
            <dt class="text-sm font-medium text-gray-500">Description</dt>
            <dd class="mt-1 text-sm text-gray-900"><%= @transaction.description.presence || "No description provided" %></dd>
          </div>

          <!-- Metadata -->
          <% if @transaction.metadata.present? && @transaction.metadata.any? %>
            <div class="sm:col-span-2">
              <dt class="text-sm font-medium text-gray-500 mb-2">Additional Information</dt>
              <dd class="mt-1">
                <div class="bg-gray-50 rounded-lg p-3">
                  <dl class="space-y-1">
                    <% @transaction.metadata.each do |key, value| %>
                      <div class="flex justify-between text-sm">
                        <dt class="text-gray-600"><%= key.to_s.titleize %>:</dt>
                        <dd class="text-gray-900 font-medium"><%= value %></dd>
                      </div>
                    <% end %>
                  </dl>
                </div>
              </dd>
            </div>
          <% end %>
        </dl>
      </div>
    </div>

    <!-- Financial Breakdown -->
    <div class="bg-white shadow rounded-lg mb-6">
      <div class="px-4 py-5 sm:p-6">
        <h3 class="text-lg leading-6 font-medium text-gray-900 mb-6">Financial Breakdown</h3>

        <dl class="space-y-4">
          <!-- Charge Amount -->
          <div class="flex justify-between items-center pb-4 border-b border-gray-200">
            <dt class="text-base font-medium text-gray-900">Charge Amount</dt>
            <dd class="text-base font-medium text-gray-900">
              $<%= sprintf("%.2f", @transaction.charge_amount_dollars) %>
            </dd>
          </div>

          <!-- Platform Fee -->
          <div class="flex justify-between items-center pb-4 border-b border-gray-200">
            <dt class="text-sm text-gray-600">
              Platform Fee (<%= number_to_percentage(@transaction.fee_percentage_applied, precision: 2) %>)
            </dt>
            <dd class="text-sm font-medium text-orange-600">
              -$<%= sprintf("%.2f", @transaction.application_fee_dollars) %>
            </dd>
          </div>

          <!-- Net Amount -->
          <div class="flex justify-between items-center pt-2">
            <dt class="text-lg font-semibold text-gray-900">Net Amount Received</dt>
            <dd class="text-lg font-semibold text-green-600">
              $<%= sprintf("%.2f", @transaction.net_amount_cents / 100.0) %>
            </dd>
          </div>
        </dl>

        <div class="mt-6 bg-blue-50 border border-blue-200 rounded-lg p-3">
          <p class="text-xs text-blue-700">
            <%= icon 'information-circle', class: 'h-4 w-4 inline mr-1' %>
            Funds are deposited directly into your connected Stripe account according to your payout schedule.
          </p>
        </div>
      </div>
    </div>

    <!-- Stripe Details -->
    <div class="bg-white shadow rounded-lg">
      <div class="px-4 py-5 sm:p-6">
        <h3 class="text-lg leading-6 font-medium text-gray-900 mb-4">Stripe Information</h3>

        <dl class="space-y-3">
          <div class="flex justify-between items-center">
            <dt class="text-sm font-medium text-gray-500">Charge ID</dt>
            <dd class="text-sm text-gray-900 font-mono"><%= @transaction.stripe_charge_id %></dd>
          </div>

          <div class="flex justify-between items-center">
            <dt class="text-sm font-medium text-gray-500">Status</dt>
            <dd>
              <% case @transaction.status %>
              <% when "succeeded" %>
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">
                  Succeeded
                </span>
              <% when "refunded" %>
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-red-100 text-red-800">
                  Refunded
                </span>
              <% when "partially_refunded" %>
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-yellow-100 text-yellow-800">
                  Partial Refund
                </span>
              <% end %>
            </dd>
          </div>
        </dl>

        <div class="mt-6">
          <a
            href="https://dashboard.stripe.com/connect/accounts/<%= Current.user.merchant_processor.processor_id %>/payments/<%= @transaction.stripe_charge_id %>"
            target="_blank"
            rel="noopener"
            class="inline-flex items-center text-sm text-blue-600 hover:text-blue-700 font-medium"
          >
            View in Stripe Dashboard
            <svg class="ml-1 h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path>
            </svg>
          </a>
        </div>
      </div>
    </div>
  </div>
</div>
