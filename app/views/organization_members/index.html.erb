<div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <div class="mb-8">
    <%= link_to @organization, class: "text-sm font-medium text-indigo-600 hover:text-indigo-500" do %>
      ← Back to <%= @organization.name %>
    <% end %>
  </div>

  <div class="flex justify-between items-center mb-8">
    <div>
      <h1 class="text-3xl font-bold text-gray-900">Team Members</h1>
      <p class="mt-2 text-sm text-gray-600">Manage team members and invitations for <%= @organization.name %></p>
    </div>
    <% if Current.admin? %>
      <%= link_to "Invite Member", new_organization_invitation_path(@organization), class: "inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md shadow-sm text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500" %>
    <% end %>
  </div>

  <!-- Active Members -->
  <div class="bg-white shadow overflow-hidden sm:rounded-md mb-8">
    <div class="px-4 py-5 sm:px-6 border-b border-gray-200">
      <h2 class="text-lg font-medium text-gray-900">Active Members (<%= @memberships.count %>)</h2>
    </div>
    <ul role="list" class="divide-y divide-gray-200">
      <% @memberships.each do |membership| %>
        <li class="px-4 py-4 sm:px-6">
          <div class="flex items-center justify-between">
            <div class="flex items-center min-w-0 flex-1">
              <% if membership.user.avatar_url.present? %>
                <img src="<%= membership.user.avatar_url %>" alt="<%= membership.user.name || membership.user.email_address %>" class="h-10 w-10 rounded-full border border-gray-200" referrerpolicy="no-referrer" crossorigin="anonymous">
              <% else %>
                <div class="h-10 w-10 bg-gray-300 rounded-full flex items-center justify-center border border-gray-200">
                  <span class="text-sm font-medium text-gray-700">
                    <%= (membership.user.name&.first || membership.user.email_address.first).upcase %>
                  </span>
                </div>
              <% end %>
              <div class="ml-4 flex-1 min-w-0">
                <div class="flex items-center gap-2">
                  <p class="text-sm font-medium text-gray-900 truncate">
                    <%= membership.user.name || membership.user.email_address %>
                  </p>
                  <% if membership.user_id == @organization.owner_id %>
                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-purple-100 text-purple-800">
                      Owner
                    </span>
                  <% elsif membership.user_id == current_user.id %>
                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800">
                      You
                    </span>
                  <% end %>
                </div>
                <p class="text-sm text-gray-500 truncate"><%= membership.user.email_address %></p>
              </div>
            </div>

            <div class="flex items-center space-x-4">
              <% if Current.admin? && membership.user_id != @organization.owner_id %>
                <%= form_with model: membership, url: organization_member_path(@organization, membership), method: :patch, class: "flex items-center space-x-2" do |f| %>
                  <%= f.select :role, [['Member', 'member'], ['Admin', 'admin']], {}, class: "block w-32 rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm", onchange: "this.form.requestSubmit()" %>
                <% end %>
              <% else %>
                <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium <%= membership.role == 'admin' ? 'bg-green-100 text-green-800' : 'bg-gray-100 text-gray-800' %>">
                  <%= membership.role.titleize %>
                </span>
              <% end %>

              <% if Current.admin? && membership.user_id != @organization.owner_id && membership.user_id != current_user.id %>
                <%= button_to "Remove", organization_member_path(@organization, membership), method: :delete, data: { turbo_confirm: "Are you sure you want to remove this member?" }, class: "text-sm text-red-600 hover:text-red-800 font-medium" %>
              <% end %>
            </div>
          </div>
        </li>
      <% end %>
    </ul>
  </div>

  <!-- Pending Invitations -->
  <% if Current.admin? %>
    <div class="bg-white shadow overflow-hidden sm:rounded-md">
      <div class="px-4 py-5 sm:px-6 border-b border-gray-200 flex justify-between items-center">
        <h2 class="text-lg font-medium text-gray-900">Pending Invitations</h2>
        <%= link_to "View All Invitations", organization_invitations_path(@organization), class: "text-sm text-indigo-600 hover:text-indigo-500 font-medium" %>
      </div>
      <% @organization.organization_invitations.valid_invitations.limit(5).each do |invitation| %>
        <div class="px-4 py-4 sm:px-6 border-b border-gray-100 last:border-b-0">
          <div class="flex items-center justify-between">
            <div class="flex-1">
              <p class="text-sm font-medium text-gray-900"><%= invitation.email %></p>
              <p class="text-sm text-gray-500">
                Invited by <%= invitation.invited_by.name || invitation.invited_by.email_address %>
                on <%= invitation.created_at.strftime("%B %d, %Y") %>
                • Expires <%= invitation.expires_at.strftime("%B %d, %Y") %>
              </p>
            </div>
            <div class="flex items-center space-x-4">
              <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-800">
                <%= invitation.role.titleize %>
              </span>
              <%= button_to "Revoke", organization_invitation_path(@organization, invitation), method: :delete, data: { turbo_confirm: "Are you sure?" }, class: "text-sm text-red-600 hover:text-red-800 font-medium" %>
            </div>
          </div>
        </div>
      <% end %>
      <% if @organization.organization_invitations.valid_invitations.none? %>
        <div class="px-4 py-8 text-center text-sm text-gray-500">
          No pending invitations
        </div>
      <% end %>
    </div>
  <% end %>
</div>
