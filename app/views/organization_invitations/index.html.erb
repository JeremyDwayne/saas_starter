<div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <div class="mb-8">
    <%= link_to organization_members_path(@organization), class: "text-sm font-medium text-indigo-600 hover:text-indigo-500" do %>
      ← Back to Team Members
    <% end %>
  </div>

  <div class="flex justify-between items-center mb-8">
    <div>
      <h1 class="text-3xl font-bold text-gray-900">Pending Invitations</h1>
      <p class="mt-2 text-sm text-gray-600">Manage pending invitations for <%= @organization.name %></p>
    </div>
    <%= link_to "Send New Invitation", new_organization_invitation_path(@organization), class: "inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md shadow-sm text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500" %>
  </div>

  <% if @pending_invitations.any? %>
    <div class="bg-white shadow overflow-hidden sm:rounded-md">
      <ul role="list" class="divide-y divide-gray-200">
        <% @pending_invitations.each do |invitation| %>
          <li class="px-4 py-4 sm:px-6">
            <div class="flex items-center justify-between">
              <div class="flex-1">
                <div class="flex items-center gap-2 mb-1">
                  <p class="text-sm font-medium text-gray-900"><%= invitation.email %></p>
                  <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-yellow-100 text-yellow-800">
                    Pending
                  </span>
                </div>
                <div class="text-sm text-gray-500 space-y-1">
                  <p>
                    Invited by <%= invitation.invited_by.name || invitation.invited_by.email_address %>
                    on <%= invitation.created_at.strftime("%B %d, %Y at %l:%M %p") %>
                  </p>
                  <p>
                    Expires on <%= invitation.expires_at.strftime("%B %d, %Y at %l:%M %p") %>
                    <% if invitation.expires_at < 24.hours.from_now %>
                      <span class="text-red-600 font-medium">(Expires soon!)</span>
                    <% end %>
                  </p>
                </div>
              </div>
              <div class="flex items-center space-x-4 ml-4">
                <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-gray-100 text-gray-800">
                  <%= invitation.role.titleize %>
                </span>
                <%= button_to "Revoke", organization_invitation_path(@organization, invitation), method: :delete, data: { turbo_confirm: "Are you sure you want to revoke this invitation?" }, class: "text-sm text-red-600 hover:text-red-800 font-medium" %>
              </div>
            </div>
          </li>
        <% end %>
      </ul>
    </div>
  <% else %>
    <div class="text-center py-12 bg-white rounded-lg shadow">
      <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
      </svg>
      <h3 class="mt-2 text-sm font-medium text-gray-900">No pending invitations</h3>
      <p class="mt-1 text-sm text-gray-500">Get started by sending an invitation to a new team member.</p>
      <div class="mt-6">
        <%= link_to "Send Invitation", new_organization_invitation_path(@organization), class: "inline-flex items-center px-4 py-2 border border-transparent shadow-sm text-sm font-medium rounded-md text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500" %>
      </div>
    </div>
  <% end %>
</div>
