<% if impersonating? %>
  <div class="sticky top-0 z-50 bg-amber-500 border-b-4 border-amber-600 shadow-lg">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center justify-between py-3">
        <div class="flex items-center space-x-3">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-amber-900" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
          </svg>
          <div>
            <p class="text-sm font-semibold text-amber-900">
              <% if Current.session.impersonating_user? %>
                Impersonating User: <span class="font-bold"><%= display_user.email_address %></span>
              <% elsif Current.session.impersonating_role? %>
                Impersonating Role: <span class="font-bold"><%= Current.impersonated_role.titleize %></span>
              <% end %>
            </p>
            <% if Current.session.impersonating_user? %>
              <p class="text-xs text-amber-800">Logged in as admin: <%= real_user.email_address %></p>
            <% end %>
          </div>
        </div>
        <div>
          <%= button_to "Stop Impersonating", stop_impersonation_path,
              method: :delete,
              class: "inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md text-amber-900 bg-amber-100 hover:bg-amber-200 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-amber-500 transition-colors",
              form: { data: { turbo: false } } %>
        </div>
      </div>
    </div>
  </div>
<% end %>
